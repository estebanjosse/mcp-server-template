{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol": "Debug"
    }
  },
  "Authentication": {
    "Mode": "none"
  },
  "TransportSecurity": {
    "ForwardedHeadersEnabled": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "RateLimiting": {
    "Enabled": false,
    "PolicyName": "mcp-per-client",
    "Identity": "clientIp",
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "SecurityHeaders": {
    "Enabled": true,
    "HstsEnabled": true,
    "HstsMaxAgeSeconds": 31536000,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false,
    "XContentTypeOptionsEnabled": true,
    "XFrameOptionsEnabled": true,
    "XFrameOptionsValue": "DENY",
    "ContentSecurityPolicy": null
  },
  "Metrics": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "McpServer": {
    "Name": "McpServer.Template",
    "Version": "1.0.0",
    "Description": "A clean, scalable MCP server template with .NET 10"
  }
}
