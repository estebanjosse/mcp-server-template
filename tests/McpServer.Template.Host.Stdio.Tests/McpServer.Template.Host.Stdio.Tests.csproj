<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="$(FluentAssertionsVersion)" />
    <ProjectReference Include="../../src/McpServer.Template.Host.Stdio/McpServer.Template.Host.Stdio.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Run the real host with its own dependencies and unmodified configuration. -->
  <Target Name="CopyStdioHost" AfterTargets="Build">
    <ItemGroup>
      <StdioHostFiles Include="../../src/McpServer.Template.Host.Stdio/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StdioHostFiles)" DestinationFiles="@(StdioHostFiles->'$(OutDir)stdio/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../src/McpServer.Template.Host.Stdio/appsettings.json" DestinationFolder="$(OutDir)stdio" />
  </Target>
</Project>
